{
  "ctx-harness": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|Read|read_file|ListDir|list_dir|grep_search|find_by_name|glob_search|codebase_search|Edit|edit_file|write_to_file|MultiEdit|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|Read|read_file|grep_search|find_by_name|glob_search|codebase_search",
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity session-start",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
