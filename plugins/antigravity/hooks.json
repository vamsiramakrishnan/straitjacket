{
  "ctx-harness": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|Read|read_file|list_dir|ListDir|grep_search|find_by_name|glob_search|codebase_search|write_to_file|replace_file_content|multi_replace_file_content|Edit|edit_file|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|view_file|Read|read_file|list_dir|ListDir|grep_search|find_by_name|glob_search|codebase_search|search_web|read_url_content|invoke_subagent|manage_task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_EXECUTABLE}} hook antigravity pre-invocation",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
