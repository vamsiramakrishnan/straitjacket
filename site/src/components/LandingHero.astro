---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';

const { entry, slug } = Astro.locals.starlightRoute;
const { title, tagline, actions } = entry.data.hero ?? {};
---

{slug !== 'docs' ? <DefaultHero /> : (
  <div class="sj-intro">
    <div class="sj-intro-copy">
      <h1 id="_top" data-page-title>{title}</h1>
      <p>{tagline}</p>
      {actions?.map(({ link, text }) => <a class="sj-start" href={link}>{text}</a>)}
    </div>
    <figure class="sj-trace" id="capture-a-failure">
      <figcaption>Capture and retrieve</figcaption>
      <div class="sj-step">
        <code class="sj-command"><span aria-hidden="true">$ </span>ctx run -- cat corpus.log</code>
        <samp class="sj-output">[ctx run:8956c843e556 profile=logtemplate/v1]<br />stdout: 20,001 lines · 979.1 KiB</samp>
      </div>
      <div class="sj-step">
        <code class="sj-command"><span aria-hidden="true">$ </span>ctx get run:8956c843e556#stdout <span class="sj-option">--lines 14238:14238</span></code>
        <samp class="sj-line"><b>L14238:</b> INFO worker-14 checkout request req-14237 <mark>fell back to legacy gateway after circuit opened</mark></samp>
      </div>
      <a class="sj-source" href="https://github.com/vamsiramakrishnan/straitjacket/blob/main/tests/fixtures/field_needle_main_digest.txt">View the full digest</a>
    </figure>
  </div>
)}
