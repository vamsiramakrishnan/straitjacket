      "content": "# EVOLVE-BLOCK-START\nimport math\n\ndef rank_blocks(items):\n    n = len(items)\n    if n == 0:\n        return []\n\n    # Step 1: Compute \"Intrinsic Rest Mass\" for each block\n    masses = {}\n    costs = {}\n    for item in items:\n        bid = item[\"id\"]\n        rel = item.get(\"relevance\", 0.0)\n        hits = item.get(\"query_hits\", item.get(\"hits\", item.get(\"query_hit_count\", 0)))\n        cost = item.get(\"byte_cost\", item.get(\"bytes\", item.get(\"cost\", item.get(\"size\", 100))))\n        \n        # Combine relevance and query hits non-linearly\n        # Hits act as a relativistic booster to base relevance\n        intrinsic_energy = (rel ** 1.5) * (1.0 + 0.35 * math.log1p(max(0, hits))) + 0.05 * math.sqrt(max(0, hits))\n        masses[bid] = intrinsic_energy\n        costs[bid] = max(1, cost)\n\n    # Step 2: Compute 1D Gravitational Field across block ID space\n    # Blocks surrounded by high-energy evidence absorb gravitational potential\n    potentials = {}\n    for item in items:\n        bid = item[\"id\"]\n        field = 0.0\n        for other in items:\n            oid = other[\"id\"]\n            if oid != bid:\n                dist = abs(bid - oid)\n                # Inverse-square-like decay along block ID distance\n                if dist <= 8:\n                    field += masses[oid] / ((dist ** 1.6) + 1.0)\n        \n        # Total relativistic score damped very gently by log-byte-cost\n        # so long essential blocks aren't lost, while absurdly huge low-value blocks sink\n        total_energy = masses[bid] + 0.12 * field\n        cost_damping = (math.log(costs[bid] + 10.0)) ** 0.35\n        potentials[bid] = total_energy / cost_damping\n\n    return [\n        item[\"id\"]\n        for item in sorted(\n            items,\n            key=lambda x: (\n                -potentials[x[\"id\"]],\n                -x.get(\"relevance\", 0.0),\n                x[\"id\"],\n            ),\n        )\n    ]\n# EVOLVE-BLOCK-END\n",
