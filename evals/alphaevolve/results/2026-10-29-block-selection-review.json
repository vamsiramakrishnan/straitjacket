      "content": "# EVOLVE-BLOCK-START\nimport math\n\n\ndef rank_blocks(items):\n    n = len(items)\n    if n == 0:\n        return []\n\n    # Extract raw signals safely across potential schema key names\n    base_energy = []\n    masses = []\n    for it in items:\n        rel = float(it.get(\"relevance\", 0.0))\n        hits = float(\n            it.get(\"query_hits\", it.get(\"query_hit_count\", it.get(\"hits\", 0)))\n        )\n        cost = float(\n            it.get(\"byte_cost\", it.get(\"bytes\", it.get(\"cost\", it.get(\"size\", 100))))\n        )\n        # Non-linear synergy between relevance and query hit count\n        energy = rel * (1.0 + 0.35 * math.log1p(max(0.0, hits))) + 0.08 * hits\n        base_energy.append(energy)\n        masses.append(max(1.0, cost))\n\n    # Relativistic 1D gravitational aura diffusion across neighboring blocks\n    aura = [0.0] * n\n    decay = 0.618033988749895  # Golden ratio conjugate harmonic decay\n    for i in range(n):\n        e_i = base_energy[i]\n        for dist in range(1, min(4, n)):\n            w = (decay ** dist) * 0.12\n            if i - dist >= 0:\n                aura[i] += w * base_energy[i - dist]\n            if i + dist < n:\n                aura[i] += w * base_energy[i + dist]\n        aura[i] += e_i\n\n    # Relativistic event-horizon mass penalty: mild logarithmic dampening\n    # so long necessary evidence blocks are preserved unless relevance is near-tie\n    scored = []\n    for i, it in enumerate(items):\n        horizon_mass = 1.0 + 0.05 * math.log1p(masses[i] / 64.0)\n        rel_score = aura[i] / horizon_mass\n        scored.append((-rel_score, - float(it.get(\"relevance\", 0.0)), it[\"id\"]))\n\n    scored.sort()\n    return [t[2] for t in scored]\n# EVOLVE-BLOCK-END\n",
